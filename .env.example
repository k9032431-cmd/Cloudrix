# Address the panel listens on
CLOUDRIX_LISTEN=:8000
# SQLite database file
CLOUDRIX_DB=/var/lib/cloudrix/cloudrix.db

# First sudo admin, created only when the database has no admins
CLOUDRIX_ADMIN_USERNAME=admin
CLOUDRIX_ADMIN_PASSWORD=change-me-please

# Public address put into client links when an inbound has no address of its own
CLOUDRIX_HOST=vpn.example.com
# Public base URL of subscriptions (default: derived from the request)
CLOUDRIX_SUB_URL=https://panel.example.com
CLOUDRIX_SUB_PATH=sub
CLOUDRIX_SUB_TITLE=Cloudrix
CLOUDRIX_SUB_UPDATE_HOURS=12

# Session lifetime; JWT secret is generated and stored in the DB when empty
CLOUDRIX_TOKEN_TTL_HOURS=24
# CLOUDRIX_JWT_SECRET=

# How often expiry/limit/reset rules run
CLOUDRIX_JOBS_INTERVAL_SECONDS=30
